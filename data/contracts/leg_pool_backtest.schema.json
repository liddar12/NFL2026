{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "leg_pool_backtest.schema.json",
  "title": "MY PARLAYS leg-pool calibration verdict",
  "description": "scripts/backtest_leg_pool.py's walk-forward comparison of a calibration refit on the WIDE player universe against the shipped slate coefficients, scored on the wide corpus. --gate exits non-zero unless the refit is better calibrated by more than the margin, keeps skill, AND carries information in absolute terms (skill > min_skill) - a perfectly calibrated coin flip is honest and useless, and without that floor the gate would adopt it. The shipped slate's own calibration lives in parlay_backtest.json and is never written here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generated_utc",
    "model",
    "ladder",
    "support",
    "residual_sd",
    "corpus",
    "verdict",
    "per_fold_coefficients",
    "calibration",
    "reliability",
    "note"
  ],
  "properties": {
    "generated_utc": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "ladder": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "number"
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
      }
    },
    "residual_sd": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "corpus": {
      "type": "object",
      "required": [
        "rows",
        "refused_out_of_support",
        "seasons",
        "players"
      ],
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "refused_out_of_support": {
          "type": "integer",
          "minimum": 0
        },
        "seasons": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "players": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "verdict": {
      "type": "object",
      "required": [
        "refit",
        "shipped",
        "adopt",
        "why"
      ],
      "properties": {
        "refit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "arm",
            "n",
            "skill",
            "ece",
            "log_loss"
          ],
          "properties": {
            "arm": {
              "type": "string",
              "minLength": 1
            },
            "n": {
              "type": "integer",
              "minimum": 0
            },
            "skill": {
              "type": [
                "number",
                "null"
              ],
              "description": "1 - loss / base-rate loss, against the SAME set's own base rate, so an easier population cannot inflate it the way raw log-loss can."
            },
            "ece": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "description": "Expected calibration error: when we say 60%, does it land 60%? THE metric for a leg pool, because a parlay multiplies its legs."
            },
            "log_loss": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "shipped": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "arm",
            "n",
            "skill",
            "ece",
            "log_loss"
          ],
          "properties": {
            "arm": {
              "type": "string",
              "minLength": 1
            },
            "n": {
              "type": "integer",
              "minimum": 0
            },
            "skill": {
              "type": [
                "number",
                "null"
              ],
              "description": "1 - loss / base-rate loss, against the SAME set's own base rate, so an easier population cannot inflate it the way raw log-loss can."
            },
            "ece": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "description": "Expected calibration error: when we say 60%, does it land 60%? THE metric for a leg pool, because a parlay multiplies its legs."
            },
            "log_loss": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "ece_margin": {
          "type": "number"
        },
        "min_skill": {
          "type": "number"
        },
        "adopt": {
          "type": "boolean"
        },
        "why": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "per_fold_coefficients": {
      "type": "object",
      "description": "Coefficients per fold season, fit on earlier seasons only - the no-peek record."
    },
    "calibration": {
      "type": "object",
      "description": "The final fit the pool builder prices with. Null for a position with no rows.",
      "additionalProperties": {
        "type": [
          "object",
          "null"
        ],
        "required": [
          "a",
          "b",
          "c"
        ],
        "properties": {
          "a": {
            "type": "number"
          },
          "b": {
            "type": "number"
          },
          "c": {
            "type": "number"
          }
        }
      }
    },
    "reliability": {
      "type": "array",
      "description": "Said vs happened per probability bin, so a miscalibration is visible as a shape and not only as a scalar.",
      "items": {
        "type": "object",
        "required": [
          "bin",
          "n",
          "said",
          "happened",
          "gap"
        ],
        "properties": {
          "bin": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "n": {
            "type": "integer",
            "minimum": 0
          },
          "said": {
            "type": "number"
          },
          "happened": {
            "type": "number"
          },
          "gap": {
            "type": "number"
          }
        }
      }
    },
    "live_2026": {
      "type": "object",
      "description": "R100 - this season's graded MY PARLAYS legs (data/my_card_scores.json joined to the offered legs in data/my_cards/) as a two-number correction layer sigmoid(a + b*logit(p)) over the pool calibration. Applied only with >= 100 graded legs, >= 2 held-out weeks each scored by a layer fit on earlier weeks only, pooled held-out log-loss better than the uncorrected pool, no held-out week worse, and slope b > 0. Outcomes only - no market number.",
      "additionalProperties": false,
      "required": [
        "weeks",
        "legs",
        "offered_mean",
        "hit_rate",
        "per_week",
        "adjustment",
        "applied",
        "reason"
      ],
      "properties": {
        "weeks": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "legs": {
          "type": "integer",
          "minimum": 0
        },
        "offered_mean": {
          "type": [
            "number",
            "null"
          ]
        },
        "hit_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "per_week": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "week",
              "n",
              "fit_weeks",
              "raw_log_loss",
              "adjusted_log_loss",
              "raw_ece",
              "adjusted_ece"
            ],
            "properties": {
              "week": {
                "type": "integer"
              },
              "n": {
                "type": "integer",
                "minimum": 0
              },
              "fit_weeks": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "raw_log_loss": {
                "type": "number"
              },
              "adjusted_log_loss": {
                "type": "number"
              },
              "raw_ece": {
                "type": "number"
              },
              "adjusted_ece": {
                "type": "number"
              }
            }
          }
        },
        "adjustment": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "a",
            "b"
          ],
          "properties": {
            "a": {
              "type": "number"
            },
            "b": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "applied": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "narrow_guard": {
      "type": [
        "object",
        "null"
      ],
      "description": "The shipped slate's population under both fits. Recorded, never gating: the slate does not read these coefficients. It exists so the trade - one fit cannot serve both populations - stays on the record.",
      "properties": {
        "pool_fit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "arm",
            "n",
            "skill",
            "ece",
            "log_loss"
          ],
          "properties": {
            "arm": {
              "type": "string",
              "minLength": 1
            },
            "n": {
              "type": "integer",
              "minimum": 0
            },
            "skill": {
              "type": [
                "number",
                "null"
              ],
              "description": "1 - loss / base-rate loss, against the SAME set's own base rate, so an easier population cannot inflate it the way raw log-loss can."
            },
            "ece": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "description": "Expected calibration error: when we say 60%, does it land 60%? THE metric for a leg pool, because a parlay multiplies its legs."
            },
            "log_loss": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "shipped_fit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "arm",
            "n",
            "skill",
            "ece",
            "log_loss"
          ],
          "properties": {
            "arm": {
              "type": "string",
              "minLength": 1
            },
            "n": {
              "type": "integer",
              "minimum": 0
            },
            "skill": {
              "type": [
                "number",
                "null"
              ],
              "description": "1 - loss / base-rate loss, against the SAME set's own base rate, so an easier population cannot inflate it the way raw log-loss can."
            },
            "ece": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "description": "Expected calibration error: when we say 60%, does it land 60%? THE metric for a leg pool, because a parlay multiplies its legs."
            },
            "log_loss": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "note": {
      "type": "string",
      "minLength": 1
    }
  }
}
