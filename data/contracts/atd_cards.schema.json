{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "atd_cards.schema.json",
  "title": "atd_cards",
  "description": "R101c - this week's WEEK-scope anytime-TD cards (ALL TD / MAJORITY TD / 50%+ SCORERS, 2-10 legs). One leg per game, so a card's model_prob is the product of its legs'; every leg is a data/leg_pool.json leg at the pool's own probability (validate_data.py re-checks both). Built by scripts/build_atd_cards.py. No book price is an input.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "season",
    "week",
    "generated_utc",
    "pool_generated_utc",
    "adopted",
    "scope",
    "pricing",
    "modes",
    "notes"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "atd_cards"
      ]
    },
    "season": {
      "type": [
        "integer",
        "null"
      ]
    },
    "week": {
      "type": [
        "integer",
        "null"
      ]
    },
    "generated_utc": {
      "type": "string"
    },
    "pool_generated_utc": {
      "type": [
        "string",
        "null"
      ]
    },
    "adopted": {
      "type": "boolean"
    },
    "scope": {
      "type": "string",
      "enum": [
        "week"
      ]
    },
    "pricing": {
      "type": "string"
    },
    "modes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all_td": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cards",
            "not_offered"
          ],
          "properties": {
            "cards": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "card_id",
                    "mode",
                    "label",
                    "n_legs",
                    "legs",
                    "model_prob",
                    "break_even_american",
                    "n_atd"
                  ],
                  "properties": {
                    "card_id": {
                      "type": "string",
                      "minLength": 8
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "all_td",
                        "majority_td",
                        "scorers_50"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "n_legs": {
                      "type": "integer",
                      "minimum": 2,
                      "maximum": 10
                    },
                    "legs": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 10,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "market",
                          "selection",
                          "model_prob",
                          "line",
                          "player",
                          "team",
                          "position",
                          "gsis_id",
                          "game_id",
                          "side"
                        ],
                        "properties": {
                          "market": {
                            "type": "string",
                            "enum": [
                              "anytime_td",
                              "qb_pass_yds",
                              "rb_rush_yds",
                              "wr_rec_yds",
                              "moneyline"
                            ]
                          },
                          "selection": {
                            "type": "string",
                            "minLength": 1
                          },
                          "model_prob": {
                            "type": "number",
                            "exclusiveMinimum": 0,
                            "exclusiveMaximum": 1
                          },
                          "line": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "player": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "team": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "position": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "gsis_id": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "game_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "side": {
                            "type": "string",
                            "enum": [
                              "home",
                              "away"
                            ]
                          }
                        }
                      }
                    },
                    "model_prob": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "exclusiveMaximum": 1
                    },
                    "break_even_american": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "n_atd": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "first_seen_utc": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "not_offered": {
