{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "parlay_leg_scores.schema.json",
  "title": "Resolved parlay-leg scores (R58) - data/parlay_leg_scores.json",
  "description": "The parlay ledger's LOCKED (pre-kickoff) legs resolved: prop legs against nflverse stats_player_week yards (hit = yards >= the locked line), moneyline / spread legs against FINAL results when a finals source is reachable (`finals_source` says which, or that none was). Per week and pooled: n, hit rate, log-loss and Brier of the as-made model_prob and of the seed pricing recomputed from the locked p_team on the SAME legs. HONESTY: weeks_resolved == 0 is a valid document that says so (`skipped`) with null metrics; a player with no stat line, a tie or a push is `unresolved` with a reason, never a miss. Written by scripts/resolve_parlay_legs.py; read by scripts/backtest_parlay.py (the live_2026 block and the weekly refit). Optional feed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "season",
    "generated_utc",
    "source",
    "finals_source",
    "ledger",
    "rule",
    "weeks_resolved",
    "legs",
    "skipped",
    "pooled",
    "by_position",
    "weeks",
    "unresolved",
    "resolved"
  ],
