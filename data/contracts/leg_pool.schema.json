{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "leg_pool.schema.json",
  "title": "MY PARLAYS candidate leg pool",
  "description": "Every leg My Parlays may build a card from this week, written by scripts/build_leg_pool.py. PLAYER-KEYED: a player is the unit the user types, so it is the unit stored, with his 2-8 in-support rungs beneath him. Prop probabilities use the POOL calibration (leg_pool_backtest.json), fit on the wide player universe; data/parlays.json keeps its own calibration and is not affected by this file. A rung is offered ONLY when its z falls inside `support` - outside it the model is extrapolating, and measured, that is where it knows least. Game legs are copied verbatim from parlays.json so the pool and the shipped card can never disagree about the same bet. MARKET POLICY: a book price is display and the terms of the bet; no market number reaches model_prob.",
  "type": "object",
  "additionalProperties": false,
  "required": ["season", "week", "generated_utc", "model", "calibration_adopted", "ladder", "support", "residual_sd", "counts", "players", "game_legs", "notes"],
  "properties": {
    "season": {"type": ["integer", "null"]},
    "week": {"type": ["integer", "null"]},
    "generated_utc": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "base_model_version": {"type": "string", "minLength": 1},
    "learning_receipt_policy": {"type": "string", "enum": ["base_receipt_v1"]},
    "live_adjustment_status": {"type": "string", "minLength": 1},
    "calibration_return": {
      "type": "object", "additionalProperties": false,
      "description": "Opt-in period-return v2 saved-generation display metadata. Must match every MY yardage receipt's input_context.calibration_return (plus action). Not current owner authentication, publication authorization or prospective accuracy proof. Absent on ordinary/legacy builds.",
      "required": ["version", "action", "scope_id", "candidate_id", "artifact_id", "owner_head_event_id", "application_context_id", "expires_utc", "evidence_basis"],
      "properties": {
        "version": {"type": "integer", "enum": [2]},
        "action": {"type": "string", "enum": ["approve", "rollback", "revoke"]},
        "scope_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "candidate_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "artifact_id": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "owner_head_event_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "application_context_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "expires_utc": {"type": ["string", "null"], "minLength": 1},
        "evidence_basis": {"type": "string", "enum": ["retrospective_refitting_policy_not_fixed_artifact_prospective_validation"]}
      }
    },
    "calibration_adopted": {"type": "boolean", "description": "False means the pool calibration did not clear its own never-regress gate. The builder refuses to write in that case, so a committed document always reads true."},
    "live_adjustment": {"type": ["object", "null"], "additionalProperties": false, "required": ["a", "b"], "properties": {"a": {"type": "number"}, "b": {"type": "number", "exclusiveMinimum": 0}}, "description": "The correction applied once to immutable base probability: sigmoid(a + b*logit(p_pool)). null means base-only. Default R100 decisions come from leg_pool_backtest.json live_2026; explicit period-return v2 additionally requires a verified fixed candidate and local owner-intent application record. A stored coefficient or PASS flag alone never activates it."},
    "ladder": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "number"}}, "description": "The rungs offered per position before the support rule filters them."},
    "support": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}, "description": "Per position, the z range the corpus actually covers. The calibration's real domain."},
    "residual_sd": {"type": "object", "additionalProperties": {"type": "number", "exclusiveMinimum": 0}, "description": "Per position, stated once: z = (mu - line) / residual_sd."},
    "counts": {
      "type": "object",
      "required": ["prop_legs", "game_legs", "players_with_a_leg", "refused_out_of_support", "players_with_no_leg"],
      "properties": {
        "prop_legs": {"type": "integer", "minimum": 0},
        "game_legs": {"type": "integer", "minimum": 0},
        "players_with_a_leg": {"type": "integer", "minimum": 0},
        "refused_out_of_support": {"type": "integer", "minimum": 0, "description": "Rungs the support rule declined to price. Counted, never hidden."},
        "players_with_no_leg": {"type": "integer", "minimum": 0, "description": "Players with no in-support rung at all. The honest 'we cannot price him this week' rather than a guessed number."},
        "no_game": {"type": "integer", "minimum": 0},
        "no_weekly_row": {"type": "integer", "minimum": 0},
        "no_projection": {"type": "integer", "minimum": 0},
        "no_calibration": {"type": "integer", "minimum": 0},
        "not_playable": {"type": "integer", "minimum": 0, "description": "R77: players whose weekly row says they do not play this week (this_week.playable false) and therefore carry no leg at any rung."},
        "atd_legs": {"type": "integer", "minimum": 0, "description": "R101: anytime-TD legs offered (0 while atd_backtest.json is not adopted)."},
        "excluded_game": {"type": "integer", "minimum": 0, "description": "R108: leg rows (prop players, game legs, ATD players) dropped because their game is on the owner's excluded list (config/excluded_games.json). Counted, never offered."}
      }
    },
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gsis_id", "player", "team", "position", "market", "game_id", "side", "mu", "p_team", "pricing", "rungs"],
        "properties": {
          "gsis_id": {"type": "string", "minLength": 1},
          "player": {"type": ["string", "null"]},
          "team": {"type": ["string", "null"]},
          "position": {"type": "string", "enum": ["QB", "RB", "WR"]},
          "market": {"type": "string", "enum": ["qb_pass_yds", "rb_rush_yds", "wr_rec_yds"]},
          "game_id": {"type": "string", "minLength": 1},
          "side": {"type": "string", "enum": ["home", "away"]},
          "mu": {"type": "number", "description": "Projected yards this week, from scripts/models/parlay_builder.project_prop_yards - the same projection the shipped slate uses."},
          "p_team": {"type": "number", "minimum": 0, "maximum": 1, "description": "This player's team's win probability, the calibration's second term."},
          "pricing": {"type": "string", "enum": ["pool_calibrated"]},
          "availability": {"type": "string", "enum": ["QUESTIONABLE"], "description": "R77: priced AND labelled (owner rule: Q priced + labelled, D excluded). Every other non-ACTIVE status is gated out before pricing (counts.not_playable), so no other value can appear."},
          "rungs": {
            "type": "array",
            "minItems": 1,
            "description": "Every in-support line for this player. A player with none is absent from `players` and counted in players_with_no_leg.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["line", "z", "selection", "model_prob"],
              "properties": {
                "learning_receipt": {
                  "type": "object", "additionalProperties": false,
                  "required": ["version", "receipt_id", "contract_id", "season", "week", "game_id", "player_id", "market", "line", "side", "direction", "comparison_operator", "base_prob", "served_prob", "base_model_version", "calibrator_version", "calibrator", "forecast_created_utc", "source_snapshot_id", "source_timestamps", "generation_sha", "publication_status", "features"],
                  "properties": {
                    "version": {"type": "integer", "enum": [1]},
                    "features": {
                      "type": "object", "additionalProperties": false,
                      "required": ["market", "line", "mu", "sd", "z", "p_team", "correlation_tags", "calibration"],
                      "properties": {
                        "market": {"type": "string", "enum": ["qb_pass_yds", "rb_rush_yds", "wr_rec_yds"]},
                        "line": {"type": "number", "exclusiveMinimum": 0},
                        "mu": {"type": "number"},
                        "sd": {"type": "number", "exclusiveMinimum": 0},
                        "z": {"type": "number"},
                        "p_team": {"type": "number", "minimum": 0, "maximum": 1},
                        "correlation_tags": {"type": "array", "items": {"type": "string"}},
                        "calibration": {"type": "object", "additionalProperties": false, "required": ["a", "b", "c"], "properties": {"a": {"type": "number"}, "b": {"type": "number"}, "c": {"type": "number"}}}
                      }
                    },
                    "input_context": {"type": "object", "description": "Frozen as-generated weekly availability/eligibility context, not proof of source freshness."},
                    "receipt_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                    "contract_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                    "season": {"type": "integer", "minimum": 2026},
                    "week": {"type": "integer", "minimum": 1, "maximum": 18},
                    "game_id": {"type": "string", "minLength": 1},
                    "player_id": {"type": "string", "minLength": 1},
                    "market": {"type": "string", "enum": ["qb_pass_yds", "rb_rush_yds", "wr_rec_yds"]},
                    "line": {"type": "number", "exclusiveMinimum": 0},
                    "side": {"type": "string", "enum": ["home", "away"]},
                    "direction": {"type": "string", "enum": ["over"]},
                    "comparison_operator": {"type": "string", "enum": ["gte"]},
                    "base_prob": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
                    "served_prob": {"type": "number", "minimum": 0.05, "maximum": 0.95},
                    "base_model_version": {"type": "string", "minLength": 1},
                    "calibrator_version": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                    "calibrator": {"type": ["object", "null"], "additionalProperties": false, "required": ["a", "b"], "properties": {"a": {"type": "number"}, "b": {"type": "number", "exclusiveMinimum": 0}}},
                    "forecast_created_utc": {"type": "string", "minLength": 1},
                    "source_snapshot_id": {"type": "string", "minLength": 1},
                    "source_timestamps": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
                    "generation_sha": {"type": ["string", "null"]},
                    "publication_status": {"type": "string", "enum": ["generated_unverified"]}
                  }
                },
                "line": {"type": "number", "exclusiveMinimum": 0},
                "z": {"type": "number"},
                "selection": {"type": "string", "minLength": 1},
                "model_prob": {"type": "number", "minimum": 0.05, "maximum": 0.95, "description": "OUR probability under the pool calibration. Never a de-vigged book number."}
              }
            }
          }
        }
      }
    },
    "game_legs": {
      "type": "array",
      "description": "Moneyline / spread legs copied verbatim from data/parlays.json, carrying the as-made book price its odds feed supplied.",
      "items": {
        "type": "object",
        "required": ["market", "selection", "model_prob", "source"],
        "properties": {
          "market": {"type": "string", "enum": ["moneyline", "spread"]},
          "selection": {"type": "string", "minLength": 1},
          "game_id": {"type": ["string", "null"]},
          "team": {"type": ["string", "null"]},
          "side": {"type": ["string", "null"], "enum": ["home", "away", null], "description": "Correlation side. Older pools may omit it; the client resolves only from an unambiguous same-team, same-event player row."},
          "model_prob": {"type": "number", "minimum": 0, "maximum": 1},
          "implied_prob": {"type": "number", "minimum": 0, "maximum": 1, "description": "Display and the terms of the bet. Never an input."},
          "source": {"type": "string", "minLength": 1}
        }
      }
    },
    "atd_legs": {
      "type": "array",
      "description": "R101 - anytime-TD legs, player-keyed, one rung each, priced by the ATD model (data/atd_week.json) and offered only while data/atd_backtest.json is adopted. model_prob is the atd_week number verbatim.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gsis_id", "player", "team", "position", "market", "game_id", "side", "pricing", "rungs"],
        "properties": {
          "gsis_id": {"type": "string", "minLength": 1},
          "player": {"type": "string", "minLength": 1},
          "team": {"type": "string", "minLength": 1},
          "position": {"type": "string", "enum": ["QB", "RB", "WR", "TE"]},
          "market": {"type": "string", "enum": ["anytime_td"]},
          "game_id": {"type": "string", "minLength": 1},
          "side": {"type": "string", "enum": ["home", "away"]},
          "pricing": {"type": "string", "enum": ["atd_model"]},
          "availability": {"type": "string", "enum": ["QUESTIONABLE"]},
          "rungs": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["line", "selection", "model_prob"], "properties": {"line": {"type": "number", "enum": [0.5]}, "selection": {"type": "string", "minLength": 1}, "model_prob": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}}}}
        }
      }
    },
    "atd_status": {"type": "string", "description": "R101 - why the pool offers ATD legs this week, or why it does not."},
    "atd_correlations": {"type": ["object", "null"], "description": "R101 - atd_backtest.json correlations, copied so a same-game pair with an ATD leg is priced with the measured rho. null when no ATD leg is offered."},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
