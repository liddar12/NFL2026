{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "learning_loops.schema.json",
  "title": "Learning loops (R105) - data/learning_loops.json",
  "description": "Latest unambiguous timestamped decision for every learning loop, separately from the effective configuration where it is established. A held proposal does not disable an adopted model. Reasons are verbatim; transitions is the append-only decision-state history. Optional effective/chronology additions preserve older records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "generated_utc",
    "policy",
    "summary",
    "loops",
    "transitions"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "learning_loops"
      ]
    },
    "generated_utc": {
      "type": "string"
    },
    "policy": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adopted",
        "held",
        "reverted",
        "measuring",
        "absent"
      ],
      "properties": {
        "adopted": {
          "type": "integer",
          "minimum": 0
        },
        "held": {
          "type": "integer",
          "minimum": 0
        },
        "reverted": {
          "type": "integer",
          "minimum": 0
        },
        "measuring": {
          "type": "integer",
          "minimum": 0
        },
        "absent": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "loops": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "group",
          "name",
          "learns",
          "moves",
          "source",
          "state",
          "why",
          "last_run_utc"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "group": {
            "type": "string",
            "enum": [
              "ships",
              "measure"
            ]
          },
          "name": {
            "type": "string"
          },
          "learns": {
            "type": "string"
          },
          "moves": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "adopted",
              "held",
              "reverted",
              "measuring",
              "absent"
            ],
            "description": "Latest decision, not whether a previously adopted configuration remains active."
          },
          "why": {
            "type": "string"
          },
          "last_run_utc": {
            "type": [
              "string",
              "null"
            ]
          },
          "runs": {
            "type": "integer",
            "minimum": 0
          },
          "live": {
            "type": "string"
          },
          "live_since_utc": {
            "type": [
              "string",
              "null"
            ]
          },
          "chronology": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "invalid_timestamps",
              "latest_conflict"
            ],
            "properties": {
              "invalid_timestamps": {
                "type": "integer",
                "minimum": 0
              },
              "latest_conflict": {
                "type": "boolean"
              }
            }
          },
          "effective": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "source",
              "since_utc",
              "version",
              "note",
              "observed_utc"
            ],
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "active",
                  "baseline",
                  "disabled",
                  "unknown",
                  "measure_only"
                ]
              },
              "source": {
                "type": "string"
              },
              "since_utc": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "note": {
                "type": "string"
              },
              "observed_utc": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "utc",
          "loop",
          "name",
          "from",
          "to",
          "why"
        ],
        "properties": {
          "utc": {
            "type": "string"
          },
          "loop": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "from": {
            "type": "string",
            "enum": [
              "adopted",
              "held",
              "reverted",
              "measuring",
              "absent"
            ]
          },
          "to": {
            "type": "string",
            "enum": [
              "adopted",
              "held",
              "reverted",
              "measuring",
              "absent"
            ]
          },
          "why": {
            "type": "string"
          }
        }
      }
    }
  }
}
