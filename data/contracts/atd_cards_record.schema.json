{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "atd_cards_record.schema.json",
  "title": "atd_cards_record",
  "description": "R101c - every ATD card as first offered (data/atd_cards/<season>_wk<NN>.json), appended on first sight and never rewritten; scripts/resolve_atd_cards.py grades it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "season",
    "week",
    "cards"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "atd_cards_record"
      ]
    },
    "season": {
      "type": "integer"
    },
    "week": {
      "type": "integer",
      "minimum": 1
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "card_id",
          "mode",
          "label",
          "n_legs",
          "legs",
          "model_prob",
          "break_even_american",
          "n_atd",
          "first_seen_utc"
        ],
        "properties": {
          "card_id": {
            "type": "string",
            "minLength": 8
          },
          "mode": {
            "type": "string",
            "enum": [
              "all_td",
              "majority_td",
              "scorers_50"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "n_legs": {
            "type": "integer",
            "minimum": 2,
            "maximum": 10
          },
          "legs": {
            "type": "array",
            "minItems": 2,
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "market",
                "selection",
                "model_prob",
                "line",
                "player",
                "team",
                "position",
                "gsis_id",
                "game_id",
                "side"
              ],
              "properties": {
                "market": {
                  "type": "string",
                  "enum": [
                    "anytime_td",
                    "qb_pass_yds",
                    "rb_rush_yds",
                    "wr_rec_yds",
                    "moneyline"
                  ]
                },
                "selection": {
                  "type": "string",
                  "minLength": 1
                },
                "model_prob": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 1
                },
                "line": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "player": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "team": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "position": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "gsis_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "game_id": {
                  "type": "string",
                  "minLength": 1
                },
                "side": {
                  "type": "string",
                  "enum": [
                    "home",
                    "away"
                  ]
                }
              }
            }
          },
          "model_prob": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1
          },
          "break_even_american": {
            "type": [
              "integer",
              "null"
            ]
          },
          "n_atd": {
            "type": "integer",
            "minimum": 0
          },
          "first_seen_utc": {
            "type": "string"
          }
        }
      }
    }
  }
}
