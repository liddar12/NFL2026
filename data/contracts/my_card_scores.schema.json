          "dial",
          "seed",
          "n_legs",
          "model",
          "result",
          "bucket",
          "legs",
          "money"
        ],
        "properties": {
          "card_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{12}$"
          },
          "week": {
            "type": "integer",
            "minimum": 1,
            "maximum": 18
          },
          "dial": {
            "type": "string",
            "enum": [
              "safe",
              "even",
              "longshot"
            ]
          },
          "seed": {
            "type": "string",
            "enum": [
              "ARI",
              "ATL",
              "BAL",
              "BUF",
              "CAR",
              "CHI",
              "CIN",
              "CLE",
              "DAL",
              "DEN",
              "DET",
              "GB",
              "HOU",
              "IND",
              "JAX",
              "KC",
              "LV",
              "LAC",
              "LAR",
              "MIA",
              "MIN",
              "NE",
              "NO",
              "NYG",
              "NYJ",
              "PHI",
              "PIT",
              "SF",
              "SEA",
              "TB",
              "TEN",
              "WAS"
            ]
          },
          "n_legs": {
            "type": "integer",
            "minimum": 2,
            "maximum": 6
          },
          "model": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "The card's recorded model probability - the number being scored."
          },
          "result": {
            "type": "string",
            "enum": [
              "hit",
              "miss",
              "void"
            ],
            "description": "A pending card is not in this list; weeks[] counts it."
          },
          "bucket": {
            "type": "string",
            "enum": [
              "all_hit",
              "push",
              "partial",
              "all_missed",
              "pending"
            ]
          },
          "legs": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "selection",
                "market",
                "result",
                "actual"
              ],
              "properties": {
                "selection": {
                  "type": "string",
                  "minLength": 1
                },
                "market": {
                  "type": "string",
                  "enum": [
                    "moneyline",
                    "spread",
                    "qb_pass_yds",
                    "rb_rush_yds",
                    "wr_rec_yds"
                  ]
                },
                "result": {
                  "type": "string",
                  "enum": [
                    "hit",
                    "miss",
                    "void",
                    "pending"
                  ]
                },
                "actual": {
                  "type": [
                    "number",
                    "object",
                    "null"
                  ],
                  "description": "Prop: the yards. Game: the final scores, or the winning side. Null when the leg did not resolve - never zero-filled."
                }
              }
            }
          },
          "money": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "net_fair",
              "net_vig2",
              "assumed_price_legs"
            ],
            "properties": {
              "net_fair": {
                "type": "number"
              },
              "net_vig2": {
                "type": "number"
              },
              "assumed_price_legs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              }
            },
            "description": "A $100 flat stake settled at the card's own recorded prices. Display-only, never a model input."
          }
        }
      }
    },
    "skipped": {
      "type": [
        "string",
        "null"
      ],
      "description": "Why nothing (or not everything) resolved. Null when the run resolved cleanly."
    }
