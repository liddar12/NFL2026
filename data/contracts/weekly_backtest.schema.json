{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "weekly_backtest.schema.json",
  "title": "Weekly-split never-regress backtest (R51) - data/weekly_backtest.json",
  "description": "The candidate weekly split (weekly_split_v2) measured against the incumbent (v1) on the committed corpus (data/fixtures/backtest_weekly/): pooled and 2025 held-out MAE / rank-corr / top-K, per-position MAE and rank-corr, band coverage and half-width, a season-week block bootstrap of the 2025 MAE delta, the factor constants the candidate applies, and the never-regress verdict. Written by scripts/backtest_weekly.py; rendered by the MODEL tab's WEEKLY SPLIT GATE card (app/views/model.js weeklyGateCard). Optional feed: absent on a clone is a skip, present is validated strictly. Every key named here is the contract the card reads; extra diagnostic keys are tolerated (no additionalProperties:false) so the producer can add measurements without redding the gate, but a missing or mistyped contract key is a failure.",
  "type": "object",
  "required": [
    "generated_utc",
    "model_candidate",
    "model_incumbent",
    "fixture",
    "season_number_rule",
    "pooled",
    "held_out_2025",
    "per_position",
    "band",
    "bootstrap",
    "factors",
    "verdict",
    "policy"
  ],
  "properties": {
    "generated_utc": {
      "type": "string",
      "minLength": 1
    },
    "model_candidate": {
      "type": "string",
      "pattern": "^weekly_split_v[0-9]+$"
    },
    "model_incumbent": {
      "type": "string",
      "pattern": "^weekly_split_v[0-9]+$"
    },
    "fixture": {
      "type": "object",
      "required": [
        "weekly_actuals",
        "games_meta",
        "seasons_scored",
        "rows",
        "pool"
      ],
      "properties": {
        "weekly_actuals": {
          "type": "string",
          "minLength": 1
        },
        "games_meta": {
          "type": "string",
          "minLength": 1
        },
        "seasons_scored": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1999,
            "maximum": 2100
          }
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "pool": {
          "type": "object",
          "required": [
            "QB",
            "RB",
            "WR",
            "TE"
          ],
          "properties": {
            "QB": {
              "type": "integer",
              "minimum": 0
            },
            "RB": {
              "type": "integer",
              "minimum": 0
            },
            "WR": {
              "type": "integer",
              "minimum": 0
            },
            "TE": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "season_number_rule": {
      "type": "string",
      "minLength": 1
    },
    "pooled": {
      "type": "object",
      "required": [
        "v1",
        "v2"
      ],
      "properties": {
        "v1": {
          "type": "object",
          "required": [
            "mae",
            "rank_corr",
            "topk"
          ],
          "properties": {
            "mae": {
              "type": "number",
              "minimum": 0
            },
            "rank_corr": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "topk": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "v2": {
          "type": "object",
          "required": [
            "mae",
            "rank_corr",
            "topk"
          ],
          "properties": {
            "mae": {
              "type": "number",
              "minimum": 0
            },
            "rank_corr": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "topk": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "held_out_2025": {
      "type": "object",
      "required": [
        "v1",
        "v2"
      ],
      "properties": {
        "v1": {
          "type": "object",
          "required": [
            "mae",
            "rank_corr",
            "topk"
          ],
          "properties": {
            "mae": {
              "type": "number",
              "minimum": 0
            },
            "rank_corr": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "topk": {
              "type": "number",
