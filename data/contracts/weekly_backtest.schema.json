    "verdict": {
      "type": "object",
      "required": [
        "adopted",
        "rule",
        "reason"
      ],
      "properties": {
        "adopted": {
          "type": "boolean"
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string"
        }
      },
      "description": "adopted is a real boolean (never a string) - the card's ADOPTED / RETAINED chip keys on it. A record WITHOUT this block renders AWAITING, not a verdict."
    },
    "policy": {
      "type": "string",
      "minLength": 1
    }
