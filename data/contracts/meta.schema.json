{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "meta.schema.json",
  "title": "Model + optimizer metadata",
  "description": "Fitted-weights table and model versions. On day zero every signal weight is 0.0 (the 'Dominance started at 0' rule) — nothing has earned weight yet. The signal_registry Node test reads weights and asserts every registry signal is present at 0.0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["season", "updated_utc", "models", "weights", "optimizer"],
  "properties": {
    "season": {
      "type": "integer",
      "minimum": 2026
    },
    "updated_utc": { "type": "string" },
    "models": {
      "type": "object",
      "description": "Map of model name -> version string.",
      "additionalProperties": { "type": "string" }
    },
    "weights": {
      "type": "object",
      "description": "Map of signal name -> fitted weight. All 0.0 on day zero.",
      "additionalProperties": { "type": "number" }
    },
    "optimizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "margin", "shrinkage"],
      "properties": {
        "objective": {
          "type": "string",
          "description": "The optimized objective. Accuracy is reported, never optimized.",
          "enum": ["log_loss"]
        },
        "margin": {
          "type": "number",
          "description": "NEVER REGRESS adoption margin (default 0.0015).",
          "minimum": 0
        },
        "shrinkage": {
          "type": "number",
          "description": "Shrinkage strength toward current weights (regularizes small samples).",
          "minimum": 0
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Free-form human notes about this fit."
    },
    "projection_baseline": {
      "type": "object",
      "description": "R49 - the games-normalized baseline rule (prior_ppg x projected_games) and WHERE it applies. `shipped_rule` is the rule proj_points actually uses today; the R49 rule replaces it only when scripts/backtest_player.py shows it beating the incumbent on BOTH pooled MAE and pooled rank-corr (never-regress). The candidate estimate always uses the R49 rule.",
      "additionalProperties": false,
      "required": ["rule", "season_games", "games_source", "absence_source", "changed_utc", "shipped_rule", "applies_to", "gate", "candidate"],
      "properties": {
        "rule": { "type": "string", "enum": ["prior_ppg_x_projected_games"] },
        "season_games": { "type": "integer", "minimum": 17, "maximum": 17 },
        "games_source": { "type": "string" },
        "absence_source": { "type": "string" },
        "changed_utc": { "type": "string" },
        "shipped_rule": { "type": "string", "enum": ["prior_season_points", "prior_ppg_x_projected_games"] },
        "applies_to": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["proj_points", "candidate_points"] } },
        "recency_weights": { "type": "array", "items": { "type": "number", "minimum": 0 } },
        "gate": {
          "type": "object",
          "description": "The measured never-regress verdict for the SHIPPED number (walk-forward 2022-2025, pooled over QB/RB/WR/TE). Numbers are copied from data/player_backtest.json baseline_gate.",
          "additionalProperties": false,
          "required": ["adopted_for_shipped", "reason"],
          "properties": {
            "adopted_for_shipped": { "type": "boolean" },
            "reason": { "type": "string" },
            "pooled_rho_total_rule": { "type": ["number", "null"] },
            "pooled_rho_ppg_rule": { "type": ["number", "null"] },
            "pooled_mae_total_rule": { "type": ["number", "null"] },
            "pooled_mae_ppg_rule": { "type": ["number", "null"] },
            "measured_utc": { "type": "string" }
          }
        },
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["signals_applied", "sd_rule"],
          "properties": {
            "signals_applied": { "type": "array", "items": { "type": "string" } },
            "signals_not_computable": { "type": "array", "items": { "type": "string" } },
            "sd_rule": { "type": "string" }
          }
        }
      }
    },
    "learning_record": {
      "type": "object",
      "description": "R49 - the honest state of the learning loop for the MODEL tab. weeks_resolved == 0 means NO 2026 week has been scored yet and mae_ppr / bias_ppr MUST be null (never invented). Written by scripts/resolve_estimates.py.",
      "additionalProperties": false,
      "required": ["weeks_resolved", "players_scored", "mae_ppr", "bias_ppr", "signals_with_weight", "updated_utc"],
      "properties": {
        "weeks_resolved": { "type": "integer", "minimum": 0 },
        "players_scored": { "type": "integer", "minimum": 0 },
        "mae_ppr": { "type": ["number", "null"], "minimum": 0 },
        "bias_ppr": { "type": ["number", "null"] },
        "candidate_mae_ppr": { "type": ["number", "null"], "minimum": 0 },
        "candidate_bias_ppr": { "type": ["number", "null"] },
        "band_coverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "signals_with_weight": { "type": "array", "items": { "type": "string" } },
        "ledger": { "type": "string" },
        "objective_ready": { "type": "boolean", "description": "True iff weeks_resolved >= the harness minimum (scripts/harness/ledger_objective.MIN_RESOLVED_WEEKS)." },
        "adoption_margin_mae": { "type": "number", "minimum": 0 },
        "note": { "type": "string" },
        "updated_utc": { "type": "string" },
        "backtest_2025": {
          "type": "object",
          "description": "Last year's projected vs actual: 2024 priors -> 2025 actuals through the same candidate machinery, from data/player_backtest.json candidate_2025.",
          "additionalProperties": false,
          "required": ["baseline_mae", "candidate_mae", "shipped_mae", "band_coverage", "players"],
          "properties": {
            "baseline_mae": { "type": ["number", "null"], "minimum": 0 },
            "candidate_mae": { "type": ["number", "null"], "minimum": 0 },
            "shipped_mae": { "type": ["number", "null"], "minimum": 0 },
            "band_coverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "players": { "type": "integer", "minimum": 0 },
            "sleeper_mae": { "type": ["number", "null"], "minimum": 0 },
            "sleeper_players": { "type": ["integer", "null"], "minimum": 0 },
            "sleeper_note": { "type": "string" },
            "signals_evaluated": { "type": "array", "items": { "type": "string" } },
            "signals_not_evaluable": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
