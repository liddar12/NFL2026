{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nfl2026:design:outcome:0.1",
  "title": "Proposed outcome v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture",
    "project_id",
    "prediction_id",
    "revision",
    "status",
    "source_record_id",
    "source_sha256",
    "source_observed_at",
    "resolved_at",
    "supersedes_revision",
    "correction_reason",
    "result"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "fixture": {
      "type": "boolean"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "prediction_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "final",
        "void"
      ]
    },
    "source_record_id": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "supersedes_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "correction_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "points"
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "class"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
